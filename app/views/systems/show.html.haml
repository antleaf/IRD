- pid = @system.ark
- unless pid.nil?
  %div.pid
    %span.pid-label Persistent Identifier (PID):
    -# %span.badge.text-bg-secondary= pid
    = resolvable_identifier(:ark, pid)


%div.row
  %div.col-lg-8
    = render 'show_general', "@system": @system
    = render 'show_technical', "@system": @system
    - if policy(@system).view_audit?
      = render 'show_audit', "@system": @system
  %div.col-lg-4
    = render 'show_curation', "@system": @system
    - if policy(@system).admin?
      = render 'show_admin', "@system": @system
